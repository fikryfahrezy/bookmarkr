{
  "name": "extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "build:ext": "web-ext build --source-dir dist/",
    "dev": "rsbuild",
    "dev:ext": "web-ext run --source-dir dist/  --target chromium",
    "format": "prettier --write .",
    "lint": "rslint",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.34",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "0.12.5",
    "web-ext": "10.3.0"
  }
}
